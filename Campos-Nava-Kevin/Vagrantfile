# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.box      = "kalilinux/rolling"
  config.vm.hostname = "kali-malware-lab"

  # SSH: host 2222 → guest 22
  # Coincide con .kali.port en config.json
  config.vm.network "forwarded_port",
    guest: 22, host: 2222, host_ip: "127.0.0.1",
    id: "ssh", auto_correct: true

  config.vm.provider "virtualbox" do |vb|
    vb.name   = "kali-malware-lab"
    vb.memory = 4096
    vb.cpus   = 2
    vb.gui    = false
  end

  # Copia la llave pública del host para que el script de provisioning la instale
  config.vm.provision "file",
    source:      "~/.ssh/id_rsa.pub",
    destination: "/tmp/host_key.pub"

  config.vm.provision "shell", path: "vagrant/provision_kali.sh"
end

# Sobreescribe el destino del proxy de Vite en desarrollo (npm run dev).
# Por defecto: motor en :8001 y servicio dinámico del host en :8002.
ENGINE_URL=http://localhost:8001
DYNAMIC_URL=http://localhost:8002

# Solo si sirves el front contra APIs en otro origen (sin el proxy de nginx/Vite):
# VITE_ENGINE_URL=http://localhost:8001
# VITE_DYNAMIC_URL=http://localhost:8002
